{document;
#url{https://tmark.waus.app/examples/media_formats.tmark}
#title{Media formats}
{p;Required formats must work in conforming tmark renderers. Unsupported examples are outside the required set; implementations may support them as extensions. Browser previews are not a conformance test.}
{h;#s{2}MUST supported}
{h;#s{3}JPEG}
{img;#caption{JPEG}https://tmark.waus.app/static/media-formats/image.jpg}
{h;#s{3}WebP}
{img;#caption{WebP}https://tmark.waus.app/static/media-formats/image.webp}
{h;#s{3}AVIF}
{img;#caption{AVIF}https://tmark.waus.app/static/media-formats/image.avif}
{h;#s{3}PNG}
{img;#caption{PNG}https://tmark.waus.app/static/media-formats/image.png}
{h;#s{3}JPEG XL}
{img;#caption{JPEG XL}https://tmark.waus.app/static/media-formats/image.jxl}
{h;#s{3}Lottie JSON}
{img;#caption{Lottie JSON}https://tmark.waus.app/static/media-formats/animation.json}
{h;#s{3}MP3 / native MP3}
{audio;#caption{MP3 / native MP3}https://tmark.waus.app/static/media-formats/tone.mp3}
{h;#s{3}FLAC / native FLAC}
{audio;#caption{FLAC / native FLAC}https://tmark.waus.app/static/media-formats/tone.flac}
{h;#s{3}Opus / Ogg}
