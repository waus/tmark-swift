{h;#s{3}AAC-LC / ISO BMFF (MP4)}
{audio;#caption{AAC-LC / ISO BMFF (MP4)}https://tmark.waus.app/static/media-formats/tone-aac-lc.m4a}
{h;#s{2}Unsupported}
{h;#s{3}GIF}
{img;#caption{GIF}https://tmark.waus.app/static/media-formats/image.gif}
{h;#s{3}BMP}
{img;#caption{BMP}https://tmark.waus.app/static/media-formats/image.bmp}
{h;#s{3}TIFF}
{img;#caption{TIFF}https://tmark.waus.app/static/media-formats/image.tiff}
{h;#s{3}PCM / WAV}
